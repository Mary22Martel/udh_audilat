{
  "name": "audit-lab-udh",
  "private": true,
  "version": "1.0.0",
  "description": "Simulador inmersivo de auditorías tributarias para estudiantes de Contabilidad (UDH).",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --disable-warning=ExperimentalWarning server/index.ts",
    "crear-admin": "tsx --disable-warning=ExperimentalWarning server/crear-admin.ts",
    "datos-demo": "tsx --disable-warning=ExperimentalWarning server/datos-demo.ts",
    "respaldo": "tsx --disable-warning=ExperimentalWarning server/respaldo.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.12",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "fastify": "^5.12.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
